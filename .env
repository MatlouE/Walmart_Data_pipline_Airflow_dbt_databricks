# ========================================================
# AIRFLOW CONFIGURATION
# ========================================================
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ========================================================
# LOCAL SOURCE DATABASE CONFIGURATION (PostgreSQL)
# ========================================================
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5433
SOURCE_DB_NAME=walmart_db
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres

# Database URL used inside Docker networks (e.g. from Airflow container)
SOURCE_DB_DOCKER_HOST=walmart-source-db
SOURCE_DB_DOCKER_PORT=5432

# ========================================================
# DATABRICKS WORKSPACE CONFIGURATION
# ========================================================
# Replace with your actual Databricks URL, HTTP path, and access token
DATABRICKS_HOST=https://<your-databricks-workspace-id>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-sql-warehouse-id>
DATABRICKS_TOKEN=dapi_your_personal_access_token_here

# Databricks Catalog & Schema Targets
DATABRICKS_CATALOG=walmart_catalog
DATABRICKS_BRONZE_SCHEMA=raw
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold